; Earnest's one-endpoint virtual playback device. This excludes the extra
; microphone, MIDI, Bluetooth, HDMI, and APO registrations in the SYSVAD sample.
[Version]
Signature = "$Windows NT$"
Class = MEDIA
ClassGUID = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider = %ProviderName%
DriverVer = 11/02/2026,13.5.16.706
CatalogFile = EarnestAudioDevice.cat
PnpLockDown = 1

[SourceDisksNames]
1 = "Earnest Audio Device",,,

[SourceDisksFiles]
EarnestAudioDevice.sys = 1

[Manufacturer]
%ManufacturerName% = EarnestAudio,NTamd64.10.0...16299

[EarnestAudio.NTamd64.10.0...16299]
%DeviceName% = EarnestAudio_Install,Root\EarnestAudioDevice

[DestinationDirs]
DriverCopy = 13

[EarnestAudio_Install.NT]
CopyFiles = DriverCopy

[DriverCopy]
EarnestAudioDevice.sys

[EarnestAudio_Install.NT.Services]
AddService = earnestaudiodevice,0x00000002,EarnestAudio_Service

[EarnestAudio_Service]
DisplayName = %ServiceName%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %13%\EarnestAudioDevice.sys

[EarnestAudio_Install.NT.Wdf]
KmdfService = earnestaudiodevice,EarnestAudio_Wdf

[EarnestAudio_Wdf]
KmdfLibraryVersion = 1.15

; SpeakerMiniports is the only registered miniport. Its WaveRT render pin also
; supplies the stream that Earnest captures through WASAPI loopback.
[EarnestAudio_Install.NT.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,%KSNAME_WaveSpeaker%,EarnestAudio.I.WaveSpeaker
AddInterface = %KSCATEGORY_RENDER%,%KSNAME_WaveSpeaker%,EarnestAudio.I.WaveSpeaker
AddInterface = %KSCATEGORY_REALTIME%,%KSNAME_WaveSpeaker%,EarnestAudio.I.WaveSpeaker
AddInterface = %KSCATEGORY_AUDIO%,%KSNAME_TopologySpeaker%,EarnestAudio.I.TopologySpeaker
AddInterface = %KSCATEGORY_TOPOLOGY%,%KSNAME_TopologySpeaker%,EarnestAudio.I.TopologySpeaker

[EarnestAudio.I.WaveSpeaker]
AddReg = EarnestAudio.I.WaveSpeaker.AddReg
[EarnestAudio.I.WaveSpeaker.AddReg]
HKR,,CLSID,,%ProxyClsid%
HKR,,FriendlyName,,%EndpointName%

[EarnestAudio.I.TopologySpeaker]
AddReg = EarnestAudio.I.TopologySpeaker.AddReg
[EarnestAudio.I.TopologySpeaker.AddReg]
HKR,,CLSID,,%ProxyClsid%
HKR,,FriendlyName,,%TopologyName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

[Strings]
ProviderName = "Earnest Audio"
ManufacturerName = "Earnest Audio"
DeviceName = "Earnest Virtual Audio Device"
ServiceName = "Earnest Virtual Audio Device Driver"
EndpointName = "Earnest Virtual Speakers"
TopologyName = "Earnest Virtual Speakers Topology"
KSNAME_WaveSpeaker = "WaveSpeaker"
KSNAME_TopologySpeaker = "TopologySpeaker"
KSCATEGORY_AUDIO = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER = "{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME = "{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY = "{DDA54A40-1E4C-11D1-A050-405705C10000}"
ProxyClsid = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
PKEY_AudioEndpoint_Association = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
KSNODETYPE_ANY = "{00000000-0000-0000-0000-000000000000}"

